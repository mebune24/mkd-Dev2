generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  name          String
  role          String          // "admin", "landlord", "tenant", "agent"
  status        String          @default("active") // "active", "suspended"
  createdAt     DateTime        @default(now())
  
  properties    Property[]      @relation("LandlordProperties")
  applications  Application[]   @relation("TenantApplications")
  kycSubmission KYCSubmission?
}

model KYCSubmission {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  tier        String   // "basic", "premium"
  status      String   @default("pending") // "pending", "verified", "rejected"
  documents   String   // JSON string of document URLs/paths
  submittedAt DateTime @default(now())
}

model Property {
  id           String        @id @default(uuid())
  landlordId   String
  landlord     User          @relation("LandlordProperties", fields: [landlordId], references: [id])
  title        String
  description  String
  location     String
  monthlyRent  Int
  deposit      Int
  status       String        @default("available") // "draft", "available", "rented"
  isVerified   Boolean       @default(false)
  amenities    String        // JSON string
  images       String        // JSON string
  createdAt    DateTime      @default(now())
  
  applications Application[]
}

model Application {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])
  tenantId     String
  tenant       User     @relation("TenantApplications", fields: [tenantId], references: [id])
  status       String   @default("submitted") // "submitted", "underReview", "approved", "rejected"
  coverLetter  String?
  submittedAt  DateTime @default(now())
}
