generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  passwordHash             String
  name                     String
  firstName                String?
  lastName                 String?
  phone                    String?
  bio                      String?
  avatarUrl                String? // Base64 or external URL
  twoFactorEnabled         Boolean   @default(false)
  pushNotificationsEnabled Boolean   @default(true)
  role                     String // "admin", "landlord", "tenant", "agent"
  status                   String    @default("active") // "pending_verification", "kyc_rejected", "active", "suspended"
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt
  termsAcceptedAt          DateTime?
  termsVersion             String?

  properties           Property[]              @relation("LandlordProperties")
  applications         Application[]           @relation("TenantApplications")
  agentVerification    AgentVerification?
  landlordVerification LandlordVerification?
  agentTransactions    AgentTransaction[]      @relation("AgentLedger")
  platformFees         PlatformFee[]           @relation("LandlordFees")
  transactions         Transaction[]           @relation("UserTransactions")
  tenantLeases         Lease[]                 @relation("TenantLeases")
  landlordLeases       Lease[]                 @relation("LandlordLeases")
  tenantRentals        Rental[]                @relation("TenantRentals")
  rnlpContracts        RnlpContract[]          @relation("TenantRnlpContracts")
  landlordRentals      Rental[]                @relation("LandlordRentals")
  subscriptions        Subscription[]
  openedDisputes       Dispute[]               @relation("OpenedDisputes")
  passwordResetToken   PasswordResetToken?
  notifications        Notification[]
  maintenanceRequests  MaintenanceRequest[]    @relation("TenantMaintenanceRequests")
  reviewsGiven         Review[]                @relation("TenantReviews")
  reviewsReceived      Review[]                @relation("LandlordReviews")
  followers            Follow[]                @relation("UserFollowing")
  following            Follow[]                @relation("UserFollowers")
  comments             Comment[]               @relation("UserComments")
  propertyLikes        PropertyLike[]
  propertyReshares     PropertyReshare[]
  tenantWallet         TenantWallet?
  tenantWalletEntries  TenantWalletEntry[]
  sentMessages         Message[]               @relation("SentMessages")
  receivedMessages     Message[]               @relation("ReceivedMessages")
  auditLogs            AuditLog[]
  landlordAgreements   AgentServiceAgreement[] @relation("LandlordAgreements")
  agentAgreements      AgentServiceAgreement[] @relation("AgentAgreements")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        String
  resourceId    String
  resourceType  String
  metadata      String?
  ipAddress     String?
  userAgent     String?
  signatureHash String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
}

model AgentVerification {
  id             String   @id @default(uuid())
  agentId        String   @unique
  agent          User     @relation(fields: [agentId], references: [id])
  status         String   @default("pending") // "pending", "approved", "rejected"
  documents      String // JSON string of documents
  nationalIdUrl  String?
  selfieUrl      String?
  businessDocUrl String?
  taxCardUrl     String?
  adminNotes     String?
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model AgentServiceAgreement {
  id           String    @id @default(uuid())
  landlordId   String
  landlord     User      @relation("LandlordAgreements", fields: [landlordId], references: [id], onDelete: Cascade)
  agentId      String
  agent        User      @relation("AgentAgreements", fields: [agentId], references: [id], onDelete: Cascade)
  status       String    @default("pending") // pending, accepted, active, suspended, terminated
  serviceTerms String
  requestedAt  DateTime  @default(now())
  acceptedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([landlordId, agentId])
  @@index([agentId, status])
}

model LandlordVerification {
  id          String   @id @default(uuid())
  landlordId  String   @unique
  landlord    User     @relation(fields: [landlordId], references: [id])
  tier        String   @default("basic") // "basic", "premium"
  status      String   @default("pending") // "pending", "approved", "rejected"
  documents   String
  adminNotes  String?
  submittedAt DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Property {
  id                       String    @id @default(uuid())
  landlordId               String
  landlord                 User      @relation("LandlordProperties", fields: [landlordId], references: [id])
  title                    String
  description              String
  location                 String
  monthlyRent              Int
  deposit                  Int
  status                   String    @default("available") // "draft", "available", "reserved", "rented", "auto_unpublished"
  amenities                String // JSON string
  images                   String // JSON string
  latitude                 Float?
  longitude                Float?
  h3Index                  String?
  bedrooms                 Int       @default(0)
  bathrooms                Int       @default(0)
  areaSqM                  Float     @default(0)
  furnished                Boolean   @default(false)
  parkingSpaces            Int       @default(0)
  hasWater                 Boolean   @default(false)
  hasElectricity           Boolean   @default(false)
  isFenced                 Boolean   @default(false)
  closeToRoad              Boolean   @default(false)
  securityMeans            String    @default("None")
  category                 String    @default("Apartment")
  acquisitionSource        String    @default("LANDLORD") // DIRECT, AGENT, LANDLORD, ADMIN, IMPORT
  acquisitionAgentId       String?
  lastConfirmedAvailableAt DateTime  @default(now())
  videoUrls                String    @default("[]") // JSON array of video tour URLs
  premiumBoostUntil        DateTime? // When set, this property is boosted to top of feed
  microMarket              String? // e.g. "Soa", "Bonamoussadi", "Bastos"
  applicationFeeRequired   Boolean   @default(true) // 2500 XAF fee required to apply
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt

  applications         Application[]
  propertyVerification PropertyVerification?
  leases               Lease[]
  rentals              Rental[]
  reviews              Review[]
  comments             Comment[]
  likes                PropertyLike[]
  reshares             PropertyReshare[]
  messages             Message[]

  @@index([status])
  @@index([category])
  @@index([location])
  @@index([monthlyRent])
  @@index([h3Index])
  @@index([premiumBoostUntil])
  @@index([microMarket])
}

model PropertyVerification {
  id         String    @id @default(uuid())
  propertyId String    @unique
  property   Property  @relation(fields: [propertyId], references: [id])
  status     String    @default("pending") // "pending", "verified", "rejected"
  level      Int       @default(0) // 0: unverified, 1: docs, 2: owner, 3: property, 4: inspected
  verifiedBy String? // Agent ID who verified it
  notes      String?
  verifiedAt DateTime?
}

model Application {
  id               String   @id @default(uuid())
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id])
  tenantId         String
  tenant           User     @relation("TenantApplications", fields: [tenantId], references: [id])
  status           String   @default("submitted") // "draft", "submitted", "under_review", "approved", "rejected", "withdrawn"
  coverLetter      String?
  landlordNote     String?
  nationalIdUrl    String?
  proofOfIncomeUrl String?
  submittedAt      DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  lease Lease?
}

model Lease {
  id                    String      @id @default(uuid())
  applicationId         String      @unique
  application           Application @relation(fields: [applicationId], references: [id])
  propertyId            String
  property              Property    @relation(fields: [propertyId], references: [id])
  tenantId              String?
  tenant                User?       @relation("TenantLeases", fields: [tenantId], references: [id])
  landlordId            String?
  landlord              User?       @relation("LandlordLeases", fields: [landlordId], references: [id])
  status                String      @default("generated") // "generated", "pending_tenant", "pending_landlord", "partially_signed", "signed", "active"
  documentUrl           String?
  tenantSignatureHash   String?
  landlordSignatureHash String?
  tenantSignedIp        String?
  landlordSignedIp      String?
  tenantSignedAt        DateTime?
  landlordSignedAt      DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @default(now()) @updatedAt

  payments Payment[]
  rental   Rental?
}

model Rental {
  id          String    @id @default(uuid())
  leaseId     String    @unique
  lease       Lease     @relation(fields: [leaseId], references: [id])
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id])
  tenantId    String
  tenant      User      @relation("TenantRentals", fields: [tenantId], references: [id])
  landlordId  String
  landlord    User      @relation("LandlordRentals", fields: [landlordId], references: [id])
  status      String    @default("active") // "active", "ended", "disputed"
  monthlyRent Int
  activatedAt DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  platformFees        PlatformFee[]
  disputes            Dispute[]
  maintenanceRequests MaintenanceRequest[]
  rnlpContract        RnlpContract?
}

model RnlpContract {
  id                String   @id @default(uuid())
  rentalId          String   @unique
  rental            Rental   @relation(fields: [rentalId], references: [id])
  tenantId          String
  tenant            User     @relation("TenantRnlpContracts", fields: [tenantId], references: [id])
  financedAmount    Int
  remainingBalance  Int
  totalMonths       Int
  monthlyInstalment Int
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  instalments RnlpInstalment[]
}

model RnlpInstalment {
  id                String       @id @default(uuid())
  contractId        String
  contract          RnlpContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount            Int
  dueDate           DateTime
  status            String       @default("due")
  paidAt            DateTime?
  providerTxId      String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  @@unique([contractId, installmentNumber])
}

model Subscription {
  id                 String    @id @default(uuid())
  landlordId         String
  landlord           User      @relation(fields: [landlordId], references: [id])
  planId             String
  status             String    @default("active") // "active", "grace_period", "expired", "cancelled"
  activeListingCount Int       @default(0)
  startedAt          DateTime  @default(now())
  expiresAt          DateTime
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
}

model Payment {
  id             String    @id @default(uuid())
  leaseId        String
  lease          Lease     @relation(fields: [leaseId], references: [id])
  type           String // "rent", "deposit", "application_fee"
  amount         Int
  status         String    @default("pending") // "created", "pending", "processing", "successful", "failed"
  idempotencyKey String    @unique
  providerTxId   String?   @unique
  dueDate        DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
}

model PlatformFee {
  id          String   @id @default(uuid())
  landlordId  String
  landlord    User     @relation("LandlordFees", fields: [landlordId], references: [id])
  rentalId    String?
  rental      Rental?  @relation(fields: [rentalId], references: [id])
  type        String // "subscription", "success_fee"
  amount      Int
  status      String   @default("due") // "not_due", "due", "processing", "paid"
  referenceId String? // e.g. Lease ID for success fee
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model AgentTransaction {
  id             String    @id @default(uuid())
  agentId        String
  agent          User      @relation("AgentLedger", fields: [agentId], references: [id])
  type           String // "commission", "withdrawal"
  amount         Int // positive for commission, negative for withdrawal
  status         String    @default("pending") // "pending", "eligible", "available", "processing", "paid", "failed"
  sourceEvent    String // e.g. "property_acquisition", "tenant_referral"
  referenceType  String    @default("LEASE")
  referenceId    String? // e.g. Lease ID
  idempotencyKey String    @unique
  eligibleAt     DateTime?
  availableAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
}

model TenantWallet {
  id           String              @id @default(uuid())
  tenantId     String              @unique
  tenant       User                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referralCode String              @unique
  balance      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  entries      TenantWalletEntry[]
  withdrawals  TenantWithdrawal[]
}

model TenantWalletEntry {
  id          String       @id @default(uuid())
  walletId    String
  wallet      TenantWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        String // "referral_bonus", "rent_credit", "withdrawal"
  amount      Int // positive credit, negative debit
  description String
  referenceId String?
  createdAt   DateTime     @default(now())
  user        User?        @relation(fields: [userId], references: [id])
  userId      String?

  @@index([walletId, createdAt])
}

model TenantWithdrawal {
  id           String       @id @default(uuid())
  walletId     String
  wallet       TenantWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount       Int
  method       String // "MTN", "ORANGE", "BANK_CARD"
  destination  String
  status       String       @default("pending")
  providerTxId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation("UserTransactions", fields: [userId], references: [id])
  amount          Int
  currency        String   @default("XAF")
  paymentMethod   String // "MTN", "ORANGE", etc.
  transactionType String // "PAYMENT", "PAYOUT"
  referenceType   String // "LEASE", "PLATFORM_FEE", "AGENT_WITHDRAWAL"
  referenceId     String // The ID of the related record
  gatewayTxId     String?  @unique // Fapshi transaction ID
  status          String   @default("PENDING") // "PENDING", "SUCCESSFUL", "FAILED"
  metadata        String? // JSON string for Fapshi webhook payload
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Dispute {
  id          String   @id @default(uuid())
  rentalId    String
  rental      Rental   @relation(fields: [rentalId], references: [id])
  openedById  String
  openedBy    User     @relation("OpenedDisputes", fields: [openedById], references: [id])
  title       String
  description String
  status      String   @default("open") // open, under_review, resolved
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "application_update", "lease_signed", "payment_due", "maintenance_update", "general"
  title     String
  body      String
  isRead    Boolean  @default(false)
  metadata  String? // JSON string for extra data
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model MaintenanceRequest {
  id           String    @id @default(uuid())
  rentalId     String
  rental       Rental    @relation(fields: [rentalId], references: [id])
  tenantId     String
  tenant       User      @relation("TenantMaintenanceRequests", fields: [tenantId], references: [id])
  title        String
  description  String
  category     String    @default("General") // "Plumbing", "Electrical", "Structural", "Appliance", "General"
  urgency      String    @default("Normal") // "Low", "Normal", "High", "Emergency"
  status       String    @default("open") // "open", "acknowledged", "in_progress", "resolved", "closed"
  images       String? // JSON array of image URLs
  landlordNote String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([rentalId])
  @@index([status])
}

model Review {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  tenantId   String
  tenant     User     @relation("TenantReviews", fields: [tenantId], references: [id])
  landlordId String
  landlord   User     @relation("LandlordReviews", fields: [landlordId], references: [id])
  rating     Int // 1–5
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([propertyId, tenantId])
  @@index([propertyId])
  @@index([landlordId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Comment {
  id         String   @id @default(uuid())
  content    String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("UserComments", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@index([createdAt])
}

model PropertyLike {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([propertyId, userId])
  @@index([propertyId])
}

model PropertyReshare {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([propertyId, userId])
  @@index([propertyId])
}

model Message {
  id         String    @id @default(uuid())
  roomId     String
  senderId   String
  receiverId String
  propertyId String?
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  sender   User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
}
